# GESBASE local - copiar a .env y completar
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gesbase
JWT_SECRET=
JWT_TTL=30d
PUBLIC_URL=http://localhost:3000

# Integraciones externas (opcionales - se pueden dejar vacías)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
