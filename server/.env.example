# GESBASE local - copiar a .env y completar
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gesbase
JWT_SECRET=
JWT_TTL=30d
PUBLIC_URL=http://localhost:3000

# Email del admin: recibe el formulario de contacto y tickets de soporte
ADMIN_EMAIL=gesbase0@gmail.com

# Envío de email - opción A: SMTP (DreamHost, recomendado)
# Si SMTP_HOST está definido se usa SMTP y se ignora Resend.
SMTP_HOST=smtp.dreamhost.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@gesbase.online
SMTP_PASS=
SMTP_FROM=GESBASE <admin@gesbase.online>

# Envío de email - opción B: Resend (alternativa)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
