[Unit]
Description=GESBASE server (Node + Express + WS)
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
WorkingDirectory=/opt/gesbase/server
EnvironmentFile=/opt/gesbase/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/gesbase.log
StandardError=append:/var/log/gesbase.log

[Install]
WantedBy=multi-user.target
